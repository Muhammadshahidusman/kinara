# Copy to .env (never commit .env). Leave DATABASE_URL empty to use the file backend.
DATABASE_URL=
# DATABASE_URL=postgresql://kinara:change-me@localhost:5432/kinara
KINARA_LOG_LEVEL=INFO
# Your Earth Engine Cloud project (scripts\gee_auth.bat signs in with the Google account that owns it)
KINARA_EE_PROJECT=
# Optional local mouza boundary shapefile (not shipped; see TRD.md section 4)
KINARA_MOUZA_FILE=
POSTGRES_PASSWORD=change-me
# JWT signing key for logins. Required on any server; generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
KINARA_SECRET_KEY=
